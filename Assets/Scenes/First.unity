    tapChoiceTextThai: "[\u0E21\u0E2D\u0E07\u0E02\u0E36\u0E49\u0E19\u0E44\u0E1B\u0E1A\u0E19\u0E17\u0E49\u0E2D\u0E07\u0E1F\u0E49\u0E32]"
