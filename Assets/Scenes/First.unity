  - background: {fileID: 1002337183066220262, guid: c94d393f25c7b6546860b1e3de630b9d, type: 3}
    character: {fileID: 1002337183066220262, guid: c94d393f25c7b6546860b1e3de630b9d, type: 3}
    text: "In the end, whatever truth we speak will always be warped through the
      lens of someone else\u2019s free will."
    textThai: "\u0E2A\u0E38\u0E14\u0E17\u0E49\u0E32\u0E22\u0E2A\u0E32\u0E23\u0E17\u0E35\u0E48\u0E40\u0E23\u0E32\u0E2A\u0E37\u0E48\u0E2D\u0E2A\u0E32\u0E23\u0E44\u0E1B\u0E01\u0E47\u0E08\u0E30\u0E16\u0E39\u0E01\u0E15\u0E35\u0E04\u0E27\u0E32\u0E21\u0E41\u0E25\u0E30\u0E14\u0E31\u0E14\u0E41\u0E1B\u0E25\u0E07\u0E42\u0E14\u0E22\u0E40\u0E08\u0E15\u0E08\u0E33\u0E19\u0E07\u0E40\u0E2A\u0E23\u0E35\u0E02\u0E2D\u0E07\u0E04\u0E19\u0E2D\u0E37\u0E48\u0E19\u0E2D\u0E22\u0E39\u0E48\u0E14\u0E35 "
