    textThai: "\u0E40\u0E23\u0E32\u0E16\u0E39\u0E01\u0E15\u0E31\u0E14\u0E02\u0E32\u0E14\u0E08\u0E32\u0E01\u0E01\u0E31\u0E19\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E2A\u0E21\u0E1A\u0E39\u0E23\u0E13\u0E4C\u0E41\u0E1A\u0E1A  "
