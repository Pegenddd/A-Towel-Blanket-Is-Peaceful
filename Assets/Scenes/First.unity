  - background: {fileID: 971134034880459738, guid: c4eb9f9cf250e9847855321d0e2ec50a, type: 3}
    character: {fileID: 971134034880459738, guid: c4eb9f9cf250e9847855321d0e2ec50a, type: 3}
    text: "If digging holes were a sport people obsessed over enough, it wouldn\u2019t
      be a single bit different from football."
    textThai: "\u0E16\u0E49\u0E32\u0E02\u0E38\u0E14\u0E2B\u0E25\u0E38\u0E21\u0E40\u0E1B\u0E47\u0E19\u0E01\u0E35\u0E2C\u0E32\u0E17\u0E35\u0E48\u0E04\u0E19\u0E04\u0E25\u0E31\u0E48\u0E07\u0E44\u0E04\u0E25\u0E49\u0E1E\u0E2D
      \u0E21\u0E31\u0E19\u0E01\u0E47\u0E44\u0E21\u0E48\u0E15\u0E48\u0E32\u0E07\u0E08\u0E32\u0E01\u0E1F\u0E38\u0E15\u0E1A\u0E2D\u0E25\u0E40\u0E25\u0E22\u0E2A\u0E31\u0E01\u0E19\u0E34\u0E14 "
