    character: {fileID: 1002337183066220262, guid: c94d393f25c7b6546860b1e3de630b9d, type: 3}
    text: '"Imprisoned by language and ego, forever separating ''myself'' from ''others.'
    textThai: "\u0E16\u0E39\u0E01\u0E01\u0E31\u0E01\u0E02\u0E31\u0E07\u0E14\u0E49\u0E27\u0E22
      '\u0E20\u0E32\u0E29\u0E32' \u0E41\u0E25\u0E30 '\u0E2D\u0E31\u0E15\u0E15\u0E32'
      \u0E17\u0E35\u0E48\u0E1A\u0E2D\u0E01\u0E27\u0E48\u0E32\u0E09\u0E31\u0E19\u0E04\u0E37\u0E2D\u0E09\u0E31\u0E19
      \u0E41\u0E25\u0E30\u0E40\u0E02\u0E32\u0E04\u0E37\u0E2D\u0E40\u0E02\u0E32  "
