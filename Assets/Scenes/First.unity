    textThai: "\u0E41\u0E04\u0E48\u0E43\u0E0A\u0E49\u0E01\u0E25\u0E49\u0E32\u0E21\u0E40\u0E19\u0E37\u0E49\u0E2D\u0E04\u0E19\u0E25\u0E48\u0E30\u0E2A\u0E48\u0E27\u0E19\u0E40\u0E09\u0E22\u0E46\r\n"
