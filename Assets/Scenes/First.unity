  - background: {fileID: -614223866405683747, guid: 5a000ac630eb4bf4f901c7ffec6612a2, type: 3}
    character: {fileID: -614223866405683747, guid: 5a000ac630eb4bf4f901c7ffec6612a2, type: 3}
    text: '"This ''iron box''... my isolating ego... it''s a curse."'
    textThai: "\u0E01\u0E25\u0E48\u0E2D\u0E07\u0E40\u0E2B\u0E25\u0E47\u0E01' \u0E43\u0E1A\u0E19\u0E35\u0E49...
      \u0E2D\u0E31\u0E15\u0E15\u0E32\u0E17\u0E35\u0E48\u0E41\u0E22\u0E01\u0E09\u0E31\u0E19\u0E2D\u0E2D\u0E01\u0E21\u0E32...
      \u0E21\u0E31\u0E19\u0E04\u0E37\u0E2D\u0E04\u0E33\u0E2A\u0E32\u0E1B"
    textSpeed: 0.03
