    character: {fileID: -614223866405683747, guid: 5a000ac630eb4bf4f901c7ffec6612a2, type: 3}
    text: Free will keeps us from dissolving and losing our identity.
    textThai: "\u0E40\u0E08\u0E15\u0E08\u0E33\u0E19\u0E07\u0E40\u0E2A\u0E23\u0E35\u0E1B\u0E01\u0E1B\u0E49\u0E2D\u0E07\u0E40\u0E23\u0E32\u0E08\u0E32\u0E01\u0E01\u0E32\u0E23\u0E2B\u0E25\u0E2D\u0E21\u0E23\u0E27\u0E21\u0E08\u0E19\u0E2A\u0E39\u0E0D\u0E40\u0E2A\u0E35\u0E22\u0E15\u0E31\u0E27\u0E15\u0E19  "
