  - background: {fileID: 971134034880459738, guid: c4eb9f9cf250e9847855321d0e2ec50a, type: 3}
    character: {fileID: 971134034880459738, guid: c4eb9f9cf250e9847855321d0e2ec50a, type: 3}
    text: 'Humans created laws.

      Humans created football.

      Humans created
      money, prices, and the value of things.'
    textThai: "\u0E21\u0E19\u0E38\u0E29\u0E22\u0E4C\u0E2A\u0E23\u0E49\u0E32\u0E07\u0E01\u0E0F\u0E2B\u0E21\u0E32\u0E22
      \u0E21\u0E19\u0E38\u0E29\u0E22\u0E4C\u0E2A\u0E23\u0E49\u0E32\u0E07\u0E1F\u0E38\u0E15\u0E1A\u0E2D\u0E25\r\n
      \u0E21\u0E19\u0E38\u0E29\u0E22\u0E4C\u0E2A\u0E23\u0E49\u0E32\u0E07\u0E40\u0E07\u0E34\u0E19
      \u0E23\u0E32\u0E04\u0E32 \u0E04\u0E38\u0E13\u0E04\u0E48\u0E32\u0E2A\u0E34\u0E48\u0E07\u0E02\u0E2D\u0E07\r\n"
    textSpeed: 0.03
